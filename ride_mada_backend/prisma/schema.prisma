generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_RIDE
}

enum VehicleType {
  MOTORCYCLE
  TAXI
  ECONOMY
  COMFORT
  SEDAN
  SUV
  MINIBUS
  VAN
  DELIVERY
}

enum RideStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RideRequestStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id         String   @id @default(uuid())
  phone      String   @unique
  email      String?  @unique
  name       String
  password   String
  photo      String?
  role       Role     @default(PASSENGER)
  isVerified Boolean  @default(false)
  fcmToken   String?
  rating     Float    @default(5.0)
  otpCode    String?
  otpExpires DateTime?
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  driver   Driver?
  bookings Booking[]

  reviewsGiven    Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewed")

  sentMessages     Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")

  favorites     Favorite[]
  reportsMade   Report[]   @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")

  notifications Notification[]
  adminLogs     AdminLog[] @relation("AdminLogs")
  payments      Payment[]
  rideRequests  RideRequest[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@index([isBlocked])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Driver {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  status     DriverStatus @default(OFFLINE)
  currentLat Float?
  currentLng Float?
  isApproved Boolean      @default(false)
  documents  Json
  rating     Float        @default(5.0)

  vehicles     Vehicle[]
  rides        Ride[]
  rideRequests RideRequest[]

  @@index([status, isApproved])
  @@index([currentLat, currentLng])
}

model Vehicle {
  id String @id @default(uuid())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  brand    String
  model    String
  color    String
  plate    String      @unique
  seats    Int
  type     VehicleType
  isActive Boolean     @default(true)

  rides Ride[]

  @@index([driverId])
}

model Ride {
  id String @id @default(uuid())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  departureLat Float
  departureLng Float
  arrivalLat   Float
  arrivalLng   Float

  departureAddress String
  arrivalAddress   String
  departureTime    DateTime

  price          Decimal
  availableSeats Int

  status RideStatus @default(PENDING)

  bookings Booking[]

  createdAt DateTime @default(now())

  @@index([status, departureTime])
  @@index([driverId])
}

model RideRequest {
  id String @id @default(uuid())

  passengerId String
  passenger   User @relation(fields: [passengerId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String

  vehicleType    VehicleType
  estimatedPrice Decimal
  finalPrice     Decimal?

  status      RideRequestStatus @default(REQUESTED)
  scheduledAt DateTime?
  couponCode  String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@index([createdAt])
}

model Booking {
  id String @id @default(uuid())

  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  passengerId String
  passenger   User   @relation(fields: [passengerId], references: [id])

  seats  Int
  status BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now())

  payments Payment[]

  @@index([passengerId])
  @@index([rideId, status])
}

model Message {
  id String @id @default(uuid())

  senderId   String
  receiverId String
  rideId     String?

  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([rideId])
}

model Review {
  id String @id @default(uuid())

  reviewerId String
  reviewedId String
  rideId     String?

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewed User @relation("Reviewed", fields: [reviewedId], references: [id])

  @@index([reviewedId])
}

model Favorite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type     String // HOME, WORK, DRIVER, DESTINATION
  targetId String?
  label    String?
  address  String?
  lat      Float?
  lng      Float?

  createdAt DateTime @default(now())

  @@unique([userId, type, targetId])
  @@index([userId])
}

model Report {
  id String @id @default(uuid())

  reporterId String
  reportedId String

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id])
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id])

  reason String
  status String @default("PENDING")

  createdAt DateTime @default(now())

  @@index([status])
}

model Payment {
  id String @id @default(uuid())

  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])
  rideRequestId String?
  rideRequest   RideRequest? @relation(fields: [rideRequestId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])

  amount        Decimal
  method        String // CASH, MVOLA, ORANGE, AIRTEL, CARD
  status        String
  transactionId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String // INFO, PROMO, RIDE_UPDATE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Coupon {
  id         String   @id @default(uuid())
  code       String   @unique
  discount   Decimal
  type       String // PERCENTAGE or FIXED
  validUntil DateTime
  isActive   Boolean  @default(true)
  usageLimit Int      @default(1)
  timesUsed  Int      @default(0)
  createdAt  DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id])
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
